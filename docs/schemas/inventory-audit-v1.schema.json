{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MrFresskopf/forge-companion/main/docs/schemas/inventory-audit-v1.schema.json",
  "title": "Forge Companion inventory audit JSON v1",
  "description": "Draft pre-1.0 output contract for forge-companion inventory --json.",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "command",
    "status",
    "request_count",
    "as_of",
    "snapshot",
    "findings",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "forge-companion-inventory-audit-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "command": {
      "const": "inventory"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "request_count": {
      "const": 0
    },
    "as_of": {
      "oneOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot": {
      "oneOf": [
        {
          "$ref": "#/$defs/snapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "ok"
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "errors": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        },
        "snapshot": {
          "type": "null"
        },
        "findings": {
          "maxItems": 0
        },
        "errors": {
          "minItems": 1,
          "maxItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "errors": {
                "prefixItems": [
                  {
                    "properties": {
                      "code": {
                        "const": "invalid-as-of"
                      }
                    },
                    "required": [
                      "code"
                    ]
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "as_of": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "errors": {
                "prefixItems": [
                  {
                    "properties": {
                      "code": {
                        "enum": [
                          "snapshot-not-found",
                          "snapshot-invalid",
                          "snapshot-read-failed"
                        ]
                      }
                    },
                    "required": [
                      "code"
                    ]
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "as_of": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": [
        "format",
        "integrity",
        "collection_count",
        "record_count"
      ],
      "properties": {
        "format": {
          "enum": [
            "forge-companion-collection-snapshot-v1",
            "forge-companion-collection-snapshot-v2"
          ]
        },
        "integrity": {
          "enum": [
            "verified",
            "unavailable"
          ]
        },
        "collection_count": {
          "type": "integer",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "forge-companion-collection-snapshot-v1"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "integrity": {
                "const": "unavailable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "forge-companion-collection-snapshot-v2"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "integrity": {
                "const": "verified"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "category",
        "item_id",
        "name",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "related_item_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "code": {
            "const": "possible-duplicate"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "required": [
          "related_item_id"
        ]
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid-as-of",
            "snapshot-not-found",
            "snapshot-invalid",
            "snapshot-read-failed"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
