{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MrFresskopf/forge-companion/main/docs/schemas/doctor-v1.schema.json",
  "title": "Forge Companion doctor JSON v1",
  "description": "Draft pre-1.0 output contract for forge-companion doctor --json.",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "command",
    "status",
    "request_count",
    "checks",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "forge-companion-doctor-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "command": {
      "const": "doctor"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "request_count": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "ok"
        },
        "request_count": {
          "const": 7
        },
        "checks": {
          "allOf": [
            {
              "$ref": "#/$defs/completeChecks"
            },
            {
              "items": {
                "properties": {
                  "status": {
                    "const": "ok"
                  }
                }
              }
            }
          ]
        },
        "errors": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "partial"
        },
        "request_count": {
          "const": 7
        },
        "checks": {
          "allOf": [
            {
              "$ref": "#/$defs/completeChecks"
            },
            {
              "contains": {
                "properties": {
                  "status": {
                    "const": "fail"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "minContains": 1
            }
          ]
        },
        "errors": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        },
        "request_count": {
          "const": 0
        },
        "checks": {
          "maxItems": 0
        },
        "errors": {
          "minItems": 1
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "completeChecks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "$ref": "#/$defs/brewsCheck"
        },
        {
          "$ref": "#/$defs/fermentablesCheck"
        },
        {
          "$ref": "#/$defs/hopsCheck"
        },
        {
          "$ref": "#/$defs/yeastsCheck"
        },
        {
          "$ref": "#/$defs/miscsCheck"
        },
        {
          "$ref": "#/$defs/equipmentCheck"
        },
        {
          "$ref": "#/$defs/stylesCheck"
        }
      ]
    },
    "brewsCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "brews"
            }
          }
        }
      ]
    },
    "fermentablesCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "inventory/fermentables"
            }
          }
        }
      ]
    },
    "hopsCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "inventory/hops"
            }
          }
        }
      ]
    },
    "yeastsCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "inventory/yeasts"
            }
          }
        }
      ]
    },
    "miscsCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "inventory/miscs"
            }
          }
        }
      ]
    },
    "equipmentCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "profiles/equipment"
            }
          }
        }
      ]
    },
    "stylesCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "resource": {
              "const": "profiles/styles"
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "required": [
        "resource",
        "status",
        "http_status",
        "code",
        "message"
      ],
      "properties": {
        "resource": {
          "enum": [
            "brews",
            "inventory/fermentables",
            "inventory/hops",
            "inventory/yeasts",
            "inventory/miscs",
            "profiles/equipment",
            "profiles/styles"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "fail"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "message": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "ok"
            },
            "http_status": {
              "const": 200
            },
            "code": {
              "const": "ok"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "fail"
            },
            "http_status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "code": {
              "const": "http-error"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "fail"
            },
            "http_status": {
              "type": "null"
            },
            "code": {
              "enum": [
                "request-failed",
                "invalid-response"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "fail"
            },
            "http_status": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 400,
                  "maximum": 599
                }
              ]
            },
            "code": {
              "not": {
                "enum": [
                  "ok",
                  "http-error",
                  "request-failed",
                  "invalid-response"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
